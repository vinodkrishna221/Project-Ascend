{
  "name": "ascend-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "jest --run",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=\".*\\.test\\.ts$\" --coverage",
    "test:integration": "jest --testPathPattern=\".*\\.integration\\.test\\.ts$\" --coverage",
    "test:e2e": "jest --testPathPattern=\".*\\.e2e\\.test\\.ts$\" --coverage",
    "test:security": "jest --testPathPattern=\".*\\.security\\.test\\.ts$\" --coverage",
    "test:auth": "ts-node src/lib/__tests__/test-runner.ts",
    "test:auth:watch": "ts-node src/lib/__tests__/test-runner.ts --watch",
    "test:auth:unit": "ts-node src/lib/__tests__/test-runner.ts --suite unit",
    "test:auth:integration": "ts-node src/lib/__tests__/test-runner.ts --suite integration",
    "test:auth:e2e": "ts-node src/lib/__tests__/test-runner.ts --suite e2e",
    "test:auth:security": "ts-node src/lib/__tests__/test-runner.ts --suite security",
    "test:coverage": "jest --coverage --coverageReporters=html --coverageReporters=text",
    "test:ci": "jest --ci --coverage --watchAll=false --passWithNoTests",
    "test:performance": "node scripts/load-testing/performance-test-runner.js",
    "test:performance:quick": "node scripts/load-testing/performance-test-runner.js quick",
    "test:load": "node scripts/load-testing/performance-test-runner.js load",
    "test:scalability": "node scripts/load-testing/performance-test-runner.js scalability",
    "test:stress": "node scripts/load-testing/performance-test-runner.js stress",
    "test:performance:all": "npm run test:performance",
    "test:performance:validate": "node scripts/load-testing/validate-setup.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@supabase/auth-ui-react": "^0.4.6",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.38.0",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "next": "^14.2.31",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.62.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^8.51.0",
    "eslint-config-next": "14.0.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "node-mocks-http": "^1.17.2",
    "supabase": "^1.226.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.0"
  }
}
