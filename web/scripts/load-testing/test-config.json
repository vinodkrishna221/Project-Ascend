{
  "testSuites": {
    "performance": {
      "name": "Performance Benchmarks",
      "description": "Response time validation and throughput testing",
      "file": "performance-benchmarks.js",
      "duration": "5m",
      "scenarios": {
        "response_time_test": {
          "executor": "constant-vus",
          "vus": 10,
          "duration": "5m"
        },
        "throughput_test": {
          "executor": "constant-arrival-rate",
          "rate": 50,
          "timeUnit": "1s",
          "duration": "3m",
          "preAllocatedVUs": 20,
          "maxVUs": 100
        }
      },
      "thresholds": {
        "response_time": ["p(50)<500", "p(90)<1000", "p(95)<2000", "p(99)<5000"],
        "error_rate": ["rate<0.05"],
        "http_req_duration": ["p(95)<2000"]
      }
    },
    "load": {
      "name": "Load Testing",
      "description": "Concurrent verification scenarios and mixed authentication flows",
      "file": "auth-load-test.js",
      "duration": "10m",
      "scenarios": {
        "concurrent_verification": {
          "executor": "ramping-vus",
          "startVUs": 0,
          "stages": [
            { "duration": "2m", "target": 50 },
            { "duration": "5m", "target": 50 },
            { "duration": "2m", "target": 100 },
            { "duration": "5m", "target": 100 },
            { "duration": "2m", "target": 0 }
          ]
        },
        "high_volume_signup": {
          "executor": "constant-arrival-rate",
          "rate": 30,
          "timeUnit": "1s",
          "duration": "10m",
          "preAllocatedVUs": 50,
          "maxVUs": 200
        }
      },
      "thresholds": {
        "http_req_duration": ["p(95)<2000"],
        "http_req_failed": ["rate<0.05"],
        "auth_response_time": ["p(90)<1000"],
        "errors": ["rate<0.1"]
      }
    },
    "scalability": {
      "name": "Scalability Testing",
      "description": "High-volume signup periods and sustained load testing",
      "file": "scalability-test.js",
      "duration": "20m",
      "scenarios": {
        "peak_signup_period": {
          "executor": "ramping-arrival-rate",
          "startRate": 0,
          "stages": [
            { "duration": "1m", "target": 10 },
            { "duration": "2m", "target": 50 },
            { "duration": "3m", "target": 100 },
            { "duration": "5m", "target": 200 },
            { "duration": "2m", "target": 500 },
            { "duration": "3m", "target": 500 },
            { "duration": "2m", "target": 100 },
            { "duration": "2m", "target": 0 }
          ],
          "preAllocatedVUs": 100,
          "maxVUs": 1000
        },
        "sustained_high_load": {
          "executor": "constant-arrival-rate",
          "rate": 150,
          "timeUnit": "1s",
          "duration": "15m",
          "preAllocatedVUs": 200,
          "maxVUs": 500
        }
      },
      "thresholds": {
        "signup_success_rate": ["rate>0.95"],
        "signup_response_time": ["p(50)<1000", "p(90)<3000", "p(95)<5000", "p(99)<10000"],
        "http_req_failed": ["rate<0.05"],
        "http_req_duration": ["p(95)<5000"]
      }
    },
    "stress": {
      "name": "Stress Testing",
      "description": "System reliability under peak load and breaking point analysis",
      "file": "stress-test.js",
      "duration": "20m",
      "scenarios": {
        "extreme_load_stress": {
          "executor": "ramping-arrival-rate",
          "startRate": 0,
          "stages": [
            { "duration": "2m", "target": 50 },
            { "duration": "2m", "target": 200 },
            { "duration": "2m", "target": 500 },
            { "duration": "3m", "target": 1000 },
            { "duration": "2m", "target": 1500 },
            { "duration": "3m", "target": 1500 },
            { "duration": "2m", "target": 500 },
            { "duration": "2m", "target": 100 },
            { "duration": "2m", "target": 0 }
          ],
          "preAllocatedVUs": 200,
          "maxVUs": 2000
        },
        "resource_exhaustion": {
          "executor": "constant-arrival-rate",
          "rate": 800,
          "timeUnit": "1s",
          "duration": "10m",
          "preAllocatedVUs": 300,
          "maxVUs": 1000
        }
      },
      "thresholds": {
        "system_reliability": ["rate>0.80"],
        "http_req_failed": ["rate<0.20"],
        "http_req_duration": ["p(95)<10000"],
        "error_recovery_time": ["p(90)<5000"]
      }
    }
  },
  "environments": {
    "local": {
      "baseUrl": "http://localhost:3000",
      "description": "Local development environment"
    },
    "staging": {
      "baseUrl": "https://staging.ascend.com",
      "description": "Staging environment"
    },
    "production": {
      "baseUrl": "https://api.ascend.com",
      "description": "Production environment (use with caution)"
    }
  },
  "testData": {
    "colleges": [
      {
        "id": "test-college-1",
        "name": "Test University",
        "domain": "testuniversity.edu",
        "hasEmailDomain": true
      },
      {
        "id": "test-college-2",
        "name": "Database College",
        "domain": null,
        "hasEmailDomain": false
      }
    ],
    "users": {
      "emailDomains": [
        "testcollege.edu",
        "university.edu",
        "college.ac.in",
        "institute.edu.in"
      ],
      "branches": [
        "Computer Science",
        "Electrical Engineering",
        "Mechanical Engineering",
        "Civil Engineering",
        "Information Technology"
      ],
      "years": [2020, 2021, 2022, 2023, 2024, 2025]
    }
  },
  "reporting": {
    "outputFormats": ["json", "summary", "html"],
    "metricsToTrack": [
      "http_req_duration",
      "http_req_failed",
      "auth_response_time",
      "verification_attempts",
      "concurrent_users",
      "signup_success_rate",
      "error_recovery_time",
      "system_reliability"
    ],
    "alertThresholds": {
      "responseTime": {
        "warning": 1000,
        "critical": 2000
      },
      "errorRate": {
        "warning": 0.05,
        "critical": 0.10
      },
      "throughput": {
        "minimum": 10,
        "target": 50
      }
    }
  },
  "monitoring": {
    "healthCheckEndpoint": "/api/v1/colleges",
    "preTestChecks": [
      {
        "name": "Server Health",
        "endpoint": "/api/v1/colleges",
        "expectedStatus": 200
      },
      {
        "name": "Database Connectivity",
        "endpoint": "/api/v1/auth/verification-status",
        "expectedStatus": 200
      }
    ],
    "postTestChecks": [
      {
        "name": "System Recovery",
        "endpoint": "/api/v1/colleges",
        "expectedStatus": 200,
        "maxResponseTime": 1000
      }
    ]
  }
}